# Supabase project URL (Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
# Supabase anon public key (never the service_role key)
VITE_SUPABASE_ANON_KEY=your-anon-key
# This clinic's id in the shared clinics table (uuid)
VITE_CLINIC_ID=00000000-0000-0000-0000-000000000000
# Uncomment for in-memory demo data (no Supabase or clinic ID required)
# VITE_DEMO=true
